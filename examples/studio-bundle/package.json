{
  "name": "studio-bundle",
  "type": "module",
  "version": "0.0.0",
  "description": "Entropy Studio's example addon bundle (terrain, water, FPS-RPG, tower defense, and more)",
  "author": "Alex Woodman <alexthegoodman@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/author/library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/author/library.git"
  },
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "deno bundle src/index.ts > dist/bundle.js",
    "build-daw": "deno bundle src/daw_synth_addon.ts > dist/daw.js",
    "build-fft-water": "deno bundle src/fft_water_addon.ts > dist/fft_water.js",
    "build-fft-river": "deno bundle src/fft_river_water_addon.ts > dist/fft_river.js",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "bumpp": "^10.3.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@types/gl-matrix": "^2.4.5",
    "alea": "^1.0.1",
    "gl-matrix": "^3.4.4",
    "marching-cubes-fast": "^0.0.172",
    "simplex-noise": "^4.0.3"
  }
}
