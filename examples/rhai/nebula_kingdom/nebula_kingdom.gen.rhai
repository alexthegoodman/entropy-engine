G::__V.CHATTER = obj_o(["concord", "drift", "ember", "synod", "hollow", "wild"], #{ concord: list(["The shoal turns sunward at the next tide.", "A new Wisp in the Reach. Watch over it.", "Light to you, traveller.", "The Old Candle gutters. Let it rest - or let it feed someone."]), drift: list(["Comet ice, fresh from the lanes. No questions.", "Toll's gone up again.", "I'll trade you a moon for that gossip.", "Never deal with anything that has a horizon."]), ember: list(["More fuel for the Regent.", "I smell cloud. Burn it.", "The forges are hungry.", "Every star a furnace. Every cloud a spark."]), synod: list(["The Silence hears.", "Sing low: a Singer is near.", "The tide is rising in the deep.", "What falls is given."]), hollow: list(["...", "no light. no light. no light.", "the king is listening.", "come closer."]), wild: list(["(a hungry clicking)", "(a long, low call)", "(the snap of something feeding)", "(a warning flash)"]) });
