G::__V.LESSONS = obj_o(["fly", "feed", "siphon", "combat", "blasts", "blast:shard", "blast:beam", "blast:seeker", "ability:pulse", "ability:veil", "ability:decoy", "ability:flare", "goal:absorb", "goal:mine", "goal:clear", "goal:defeat", "goal:defend", "goal:feed", "goal:lure", "goal:sling", "goal:standing", "goal:tribute", "facets", "hole", "star", "law", "lightwaves", "fold", "forms", "yield", "deeds", "dispersed", "affix", "species:lurker", "species:splitter", "species:prism", "species:wraith"], #{ fly: obj_o(["title", "text"], #{ title: "FLYING", text: "{steer} to turn, {move} to fly. {rise} and {sink} to climb and dive. Hold {stride} to Lightstride: the longer you hold it, the faster you go." }), feed: obj_o(["title", "text"], #{ title: "FEEDING", text: "You grow by eating. Fly into motes and any rubble less than half your size; motes drift to you from close by." }), siphon: obj_o(["title", "text"], #{ title: "SIPHONING", text: "Worlds too big to swallow are drunk. Come close, put the reticle on one, and hold {siphon}. The reticle says when you are in reach." }), combat: obj_o(["title", "text"], #{ title: "FIGHTING", text: "Red names are hostile. {fire} throws your blast at whatever is under the reticle; it costs charge, which refills on its own. Cohesion is your life." }), blasts: obj_o(["title", "text"], #{ title: "BLASTS", text: "You know more than one blast now: {blast} to choose. Each suits a different foe - the Codex {codex} says which." }), "blast:shard": obj_o(["title", "text"], #{ title: "SHARDFALL", text: "A close spray of seven shards. Get near, then {fire}: it shreds packs and Splitters, but is useless at range." }), "blast:beam": obj_o(["title", "text"], #{ title: "SUNTHREAD", text: "Hold {fire} for a continuous ray that burns the first thing it touches. It drinks charge fast, and glass cannot turn it back." }), "blast:seeker": obj_o(["title", "text"], #{ title: "SEEKERS", text: "{fire} looses three motes that hunt the nearest enemy on their own. Good when foes are fast, or behind you." }), "ability:pulse": obj_o(["title", "text"], #{ title: "THE PULSE", text: "{pulse} throws a shell of light: it strikes and throws back everything hostile near you, and blows away incoming bolts." }), "ability:veil": obj_o(["title", "text"], #{ title: "THE VEIL", text: "{veil} goes dark: hunters see you from a quarter as far. It drinks charge, and acting (firing, siphoning, striding) lifts it." }), "ability:decoy": obj_o(["title", "text"], #{ title: "SHED", text: "{decoy} casts off a knot of your own mass behind you. Hunters chase it, and wandering black holes prefer it to you." }), "ability:flare": obj_o(["title", "text"], #{ title: "STARFIRE", text: "{flare} pours out the light of the stars you have eaten in a long burning cone ahead of you. Aim, then press it." }), "goal:absorb": obj_o(["title", "text"], #{ title: "GATHERING", text: "Motes are the bright specks of light. Fly through them; they fall to you from close by." }), "goal:mine": obj_o(["title", "text"], #{ title: "MINING A WORLD", text: "Fly to the marked world, aim at it and hold {siphon} until nothing is left. Bigger worlds take longer; grow first if one is slow." }), "goal:clear": obj_o(["title", "text"], #{ title: "CLEARING A REGION", text: "Destroy every creature of the group: the nearest is marked. Use {fire}, and {pulse} when they swarm you." }), "goal:defeat": obj_o(["title", "text"], #{ title: "A CHAMPION", text: "A named foe, much stronger than its kind. Wear it down from range; when it yields you will have a choice to make." }), "goal:defend": obj_o(["title", "text"], #{ title: "DEFENDING", text: "Raiders come in waves for the creatures you protect. Meet each wave (marked RAIDERS) before it arrives, and break it." }), "goal:feed": obj_o(["title", "text"], #{ title: "TRICKING HUNTERS", text: "Hunters fly straight at you and never look where they are going. Get them chasing you, then keep the black hole between you and them: they fall in." }), "goal:lure": obj_o(["title", "text"], #{ title: "LEADING A BLACK HOLE", text: "A wandering hole drifts toward the biggest mass it feels. Let it see you, then fly so its destination lies between you and it, and keep ahead." }), "goal:sling": obj_o(["title", "text"], #{ title: "SLINGSHOT", text: "Dip fast into a black hole's ergosphere - the ring where the warning shows - and fly out the far side. It flings you on, faster. Never touch the core." }), "goal:standing": obj_o(["title", "text"], #{ title: "STANDING", text: "Governments judge you by tribute, by the laws you keep and by whom you kill. Press {tribute} beside an envoy to give a twentieth of your mass." }), "goal:tribute": obj_o(["title", "text"], #{ title: "TRIBUTE", text: "Fly close to an envoy and press {tribute} to give a twentieth of your mass for their favour." }), facets: obj_o(["title", "text"], #{ title: "FACET POINTS", text: "Every level gives you a facet point. Open the Codex {codex} and spend it on Density, Radiance, Reach and more." }), hole: obj_o(["title", "text"], #{ title: "BLACK HOLES", text: "A black hole cannot be eaten. Its pull grows steeply as you near, and its horizon tears a third of you away. No lightwave crosses its shadow." }), star: obj_o(["title", "text"], #{ title: "STARS FLARE", text: "A star throws flares while you siphon it. When FLARE flashes on screen, hold {stride} to ride through it unhurt." }), law: obj_o(["title", "text"], #{ title: "LIVING WORLDS", text: "Worlds that 'carry life' are under a government's law. Feeding on one is a crime, and a deed of Ruin: its soldiers will hunt you." }), lightwaves: obj_o(["title", "text"], #{ title: "LIGHTWAVES", text: "Creatures speak in light; what reaches you is shown at the right. {attune} lets you see the waves. Foreign tongues come clear as you listen." }), fold: obj_o(["title", "text"], #{ title: "FOLDING", text: "This region is yours. Open the Star Chart {chart} and choose the next region to fold there - in a moment, in any galaxy." }), forms: obj_o(["title", "text"], #{ title: "CHOOSE YOUR FORM", text: "You are wide enough to choose what kind of nebula you are: Emission, Reflection, Dark or Planetary. Open the Codex {codex} to choose." }), "yield": obj_o(["title", "text"], #{ title: "MERCY OR HUNGER", text: "{name} yields. Press {tribute} near it to spare it (Grace) - or strike it again to devour it (Ruin). Either way the fight is won." }), deeds: obj_o(["title", "text"], #{ title: "GRACE AND RUIN", text: "What you do shapes what you become. Mercy, tribute and defending the weak bring Grace; crimes and devouring bring Ruin. Your light shows which." }), dispersed: obj_o(["title", "text"], #{ title: "COHESION", text: "Cohesion only knits while you are fed and unhurt for a few seconds. Keep eating, keep moving, and Pulse what crowds you." }), affix: obj_o(["title", "text"], #{ title: "VARIANTS", text: "Some hunters are Swift, Armoured, Volatile or Vampiric: the first word of the name says which. Never finish a Volatile one up close." }), "species:lurker": obj_o(["title", "text"], #{ title: "LURKERS", text: "Lurkers hide until you are close. {attune} shows them, and the Pulse {pulse} flushes them out." }), "species:splitter": obj_o(["title", "text"], #{ title: "SPLITTERS", text: "Splitters burst into two smaller ones when broken. Shardfall ({blast} to switch) catches both halves at once." }), "species:prism": obj_o(["title", "text"], #{ title: "GLASS SENTINELS", text: "Glass turns the Lance and Seekers straight back at you. Use Sunthread or Shardfall ({blast}), the Pulse, or Starfire." }), "species:wraith": obj_o(["title", "text"], #{ title: "HOLLOW WRAITHS", text: "Wraiths fold space to appear beside you, then sting. Keep moving, and Pulse {pulse} them away when they land." }) });
G::__V.GOAL_HOW = obj_o(["absorb", "mine", "clear", "defeat", "defend", "feed", "lure", "sling", "standing", "tribute"], #{ absorb: "Fly through the bright motes; they drift to you from close by.", mine: "Fly to the marked world, aim at it and hold {siphon} until it is gone.", clear: "Hunt them down with {fire}; the nearest is marked. {pulse} when they crowd you.", defeat: "Wear the marked champion down with {fire}. When it yields: {tribute} to spare, or strike to devour.", defend: "Meet each raiding wave (marked) and break it before it reaches the shoal.", feed: "Get them chasing you, then keep the black hole between you and them.", lure: "Let the hole follow you, and keep its destination between you and it.", sling: "Fly fast into the ergosphere warning ring and out the far side; never the core.", standing: "Fly to the envoys and press {tribute}; keep their laws.", tribute: "Fly close to the envoy and press {tribute}." });
