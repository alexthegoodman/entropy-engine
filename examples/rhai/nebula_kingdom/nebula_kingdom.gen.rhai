G::__V.PLANET_LOOK = obj_o(["rock", "ice", "ocean", "lava", "desert", "gas", "banded"], #{ rock: 0.0, ice: 1.0, ocean: 2.0, lava: 3.0, desert: 4.0, gas: 5.0, banded: 6.0 });
G::__V.GLOW_KIND = obj_o(["gas", "halo", "corona", "wave", "spark", "bolt", "disc", "rings", "rift", "photon", "fire", "shock", "mark", "mote", "stream"], #{ gas: 0.0, halo: 1.0, corona: 2.0, wave: 3.0, spark: 4.0, bolt: 5.0, disc: 6.0, rings: 7.0, rift: 8.0, photon: 9.0, fire: 11.0, shock: 12.0, mark: 13.0, mote: 14.0, stream: 15.0 });
