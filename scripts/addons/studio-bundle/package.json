{
  "name": "terrain-addon",
  "type": "module",
  "version": "0.0.0",
  "description": "Terrain Addon for Entropy Engine",
  "author": "Alex Woodman <alexthegoodman@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/author/library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/author/library.git"
  },
  "bugs": {
    "url": "https://github.com/author/library/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build-tsdown": "tsdown",
    "build": "deno bundle src/index.ts > dist/bundle.js",
